                "available": {
                    "description": "Available is true only when latest is confidently newer.",
                    "type": "boolean"
                },
                "checked": {
                    "description": "Checked is false until a check completes, so \"unknown\" is\ndistinguishable from \"up to date\".",
                    "type": "boolean"
                },
                "current": {
                    "description": "Current is the running version.",
                    "type": "string",
                    "example": "0.1.0"
                },
                "enabled": {
                    "description": "Enabled mirrors update_check in obs_viewer.conf.",
                    "type": "boolean"
                },
                "latest": {
                    "description": "Latest is the newest published release, absent if unknown.",
                    "type": "string",
                    "example": "0.2.0"
                },
                "url": {
                    "description": "URL is the release page.",
                    "type": "string",
                    "example": "https://github.com/labmk/obs-viewer/releases/tag/v0.2.0"
                }
            }
        },
        "server.VersionResponse": {
            "type": "object",
            "properties": {
                "arch": {
                    "type": "string"
                },
                "idle_timeout_seconds": {
                    "type": "integer"
                },
                "os": {
                    "type": "string"
                },
                "version": {
                    "type": "string"
                }
            }
        }
    }
}