{
    "schemes": [
        "http",
        "https"
    ],
    "swagger": "2.0",
    "info": {
        "description": "Local viewer for log, metric and trace files: NDJSON, EVTX,\nXML, and rule-driven text logs, queried through DuckDB.\nThe OpenAPI spec is the source of truth for the generated\nTypeScript client used by the React frontend.",
        "title": "obs-viewer API",
        "contact": {},
        "version": "0.1.0"
    },
    "basePath": "/",
    "paths": {
        "/api/browse": {
            "get": {
                "description": "Lists directory contents (or zip-archive contents when the path points at a .zip file). Browsers cannot access the local filesystem; this endpoint is how the file picker enumerates folders.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "files"
                ],
                "summary": "Backend file browser",
                "parameters": [
                    {
                        "type": "string",
                        "description": "absolute path to list; defaults to the user home directory",
                        "name": "path",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/server.BrowseResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/server.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/export": {
            "post": {
                "description": "Reruns the query against DuckDB and writes the result to output_path via COPY ... (FORMAT JSON, ARRAY false).",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "export"
                ],
                "summary": "Export filtered rows to NDJSON",
                "parameters": [
                    {
                        "description": "query + output path",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/server.ExportRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/server.ExportResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/server.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/server.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/export/self-copy": {
            "post": {
                "description": "F13 — drops the running binary into target_dir so a single zip can carry both data and viewer.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "export"
                ],
                "summary": "Copy the binary alongside exported data",
                "parameters": [
                    {
                        "description": "destination directory",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/server.SelfCopyRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/server.SelfCopyResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/server.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/server.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/field-samples": {
            "get": {
                "description": "Returns the DISTINCT value set per requested field (default list when `fields` query param is absent). Fields whose distinct count exceeds the cap (30) are returned with an empty array — signal to the caller that the field is too high-cardinality to be useful as a literal value list. Feeds the query builder's value-suggestion datalist.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "query"
                ],
                "summary": "Distinct sample values for low-cardinality fields",
                "parameters": [
                    {
                        "type": "string",
                        "description": "comma-separated list of field names; default: service.name,host.name,SeverityText,log.level,event.category,_source_format",
                        "name": "fields",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "max values per field (default 30)",
                        "name": "cap",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "array",
                                "items": {
                                    "type": "string"
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/server.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/files": {
            "get": {
                "description": "Returns every file the engine currently has loaded plus the auto-detected timestamp column.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "files"
                ],
                "summary": "List loaded files",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/server.FilesResponse"
                        }
                    }
                }
            }
        },
        "/api/files/load": {
            "post": {
                "description": "Loads a single file by absolute path. Supports virtual zip paths in the form `C:\\foo.zip|inner.ndjson` — the inner entry is extracted next to the zip and then ingested. Dispatches through the ingest layer so non-NDJSON formats (EVTX, XML, block, line) are handled too.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "files"
                ],
                "summary": "Load a file",
                "parameters": [
                    {
                        "description": "path to load",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/server.PathRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/server.StatusResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/server.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/files/load-dir": {
            "post": {
                "description": "Bulk load. Each file is ingested through the dispatch layer; unsupported entries land in `errors` rather than aborting the load.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "files"
                ],
                "summary": "Load every supported file in a directory or zip",
                "parameters": [
                    {
                        "description": "directory or zip path",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/server.PathRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/server.LoadDirResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/server.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/files/toggle": {
            "post": {
                "description": "Toggles whether a loaded file participates in subsequent queries. Cheaper than unload+load — the table stays in DuckDB, just excluded from UNION ALL.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "files"
                ],
                "summary": "Enable / disable a file",
                "parameters": [
                    {
                        "description": "file id + enabled flag",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/server.ToggleRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/server.StatusResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/server.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/files/unload": {
            "post": {
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "files"
                ],
                "summary": "Unload a file",
                "parameters": [
                    {
                        "description": "file id",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/server.IDRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/server.StatusResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/server.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/modules": {
            "get": {
                "description": "Returns one manifest per enabled module in Add() order. The SPA reads this at boot to decide which tabs to render and to inject the branding stylesheet + favicons.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "modules"
                ],
                "summary": "List enabled modules",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/server.ModulesResponse"
                        }
                    }
                }
            }
        },
        "/api/query": {
            "post": {
                "description": "Runs the assembled filter set (field clauses, time window, optional free-text search) against the UNION ALL of enabled files. Sort, offset, and limit drive paging. Free-text search uses DuckDB ILIKE on a TRY_CAST-VARCHAR'd row.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "query"
                ],
                "summary": "Query the loaded files",
                "parameters": [
                    {
                        "description": "query parameters",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/server.QueryRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/server.QueryResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/server.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/server.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/settings": {
            "get": {
                "description": "Persisted to obs_viewer_settings.json next to the binary. Only the fields present in the POST body are updated.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "core"
                ],
                "summary": "Get or persist user settings",
                "parameters": [
                    {
                        "description": "POST only: partial settings patch",
                        "name": "body",
                        "in": "body",
                        "schema": {
                            "$ref": "#/definitions/server.SettingsBody"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/server.SettingsBody"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/server.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/server.ErrorResponse"
                        }
                    }
                }
            },
            "post": {
                "description": "Persisted to obs_viewer_settings.json next to the binary. Only the fields present in the POST body are updated.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "core"
                ],
                "summary": "Get or persist user settings",
                "parameters": [
                    {
                        "description": "POST only: partial settings patch",
                        "name": "body",
                        "in": "body",
                        "schema": {
                            "$ref": "#/definitions/server.SettingsBody"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/server.SettingsBody"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/server.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/server.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/timerange": {
            "get": {
                "description": "MIN/MAX of the active timestamp column across the UNION ALL, plus the list of timestamp-like columns the engine detected.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "query"
                ],
                "summary": "Time bounds of loaded data",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/server.TimeRangeResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/server.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/timestamp-field": {
            "get": {
                "description": "GET returns the column the engine currently sorts by. POST overrides it; the engine silently falls back to the default if the requested field is absent from the loaded files.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "query"
                ],
                "summary": "Get or set the active timestamp column",
                "parameters": [
                    {
                        "description": "POST only: requested column",
                        "name": "body",
                        "in": "body",
                        "schema": {
                            "$ref": "#/definitions/server.TimestampFieldRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/server.TimestampFieldResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/server.ErrorResponse"
                        }
                    }
                }
            },
            "post": {
                "description": "GET returns the column the engine currently sorts by. POST overrides it; the engine silently falls back to the default if the requested field is absent from the loaded files.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "query"
                ],
                "summary": "Get or set the active timestamp column",
                "parameters": [
                    {
                        "description": "POST only: requested column",
                        "name": "body",
                        "in": "body",
                        "schema": {
                            "$ref": "#/definitions/server.TimestampFieldRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/server.TimestampFieldResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/server.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/update": {
            "get": {
                "description": "Reports whether a newer release exists. Read-only — obs-viewer never downloads or installs anything. Returns enabled=false when the check is switched off, which the UI must distinguish from \"up to date\".",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "system"
                ],
                "summary": "Release update status",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/server.UpdateResponse"
                        }
                    }
                }
            }
        },
        "/api/version": {
            "get": {
                "description": "Lightweight liveness endpoint. The frontend uses this to drive an adaptive 30s / 5s healthcheck.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "core"
                ],
                "summary": "Server version + platform info",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/server.VersionResponse"
                        }
                    }
                }
            }
        }
    },
